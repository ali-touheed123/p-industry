diff --git a/src/lib/ceo-approval.ts b/src/lib/ceo-approval.ts
new file mode 100644
index 0000000..97e88cd
--- /dev/null
+++ b/src/lib/ceo-approval.ts
@@ -0,0 +1,86 @@
+import { SignJWT, jwtVerify } from 'jose';
+import { NextRequest, NextResponse } from 'next/server';
+import { getJwtSecret } from './jwt-secrets';
+import type { UserSession } from './session';
+
+/**
+ * CEO approval — a short-lived, tenant- and user-bound token that a staff session
+ * receives after entering a CEO password. Protected routes (stock adjustment, price
+ * edits, product edits, receipt settings) require it for staff roles.
+ *
+ * The token is signed with a key DERIVED from the session secret so it can never be
+ * accepted as a normal session cookie, and carries its own audience claim.
+ */
+export const CEO_APPROVAL_HEADER = 'x-ceo-approval';
+export const CEO_APPROVAL_TTL_SEC = 60 * 60; // 1 hour
+const CEO_APPROVAL_AUDIENCE = 'pyntflow-ceo-approval';
+
+function getApprovalKey(): Uint8Array {
+  const base = getJwtSecret();
+  const suffix = new TextEncoder().encode(':ceo-approval:v1');
+  const key = new Uint8Array(base.length + suffix.length);
+  key.set(base, 0);
+  key.set(suffix, base.length);
+  return key;
+}
+
+/** Roles that already are the CEO (or above) and never need the approval token. */
+export function isCeoLevelRole(role?: string | null): boolean {
+  return role === 'ceo' || role === 'developer';
+}
+
+export async function createCeoApprovalToken(
+  session: UserSession
+): Promise<{ token: string; expiresAt: number }> {
+  const expiresAt = Date.now() + CEO_APPROVAL_TTL_SEC * 1000;
+  const token = await new SignJWT({
+    userId: session.userId,
+    tenantId: session.tenantId,
+  })
+    .setProtectedHeader({ alg: 'HS256' })
+    .setAudience(CEO_APPROVAL_AUDIENCE)
+    .setIssuedAt()
+    .setExpirationTime(`${CEO_APPROVAL_TTL_SEC}s`)
+    .sign(getApprovalKey());
+  return { token, expiresAt };
+}
+
+export async function hasValidCeoApproval(
+  req: NextRequest,
+  session: UserSession
+): Promise<boolean> {
+  if (isCeoLevelRole(session.role)) return true;
+  const token = req.headers.get(CEO_APPROVAL_HEADER);
+  if (!token) return false;
+  try {
+    const { payload } = await jwtVerify(token, getApprovalKey(), {
+      audience: CEO_APPROVAL_AUDIENCE,
+    });
+    return payload.userId === session.userId && payload.tenantId === session.tenantId;
+  } catch {
+    return false;
+  }
+}
+
+export type CeoGateResult = { ok: true } | { ok: false; response: NextResponse };
+
+/**
+ * Call AFTER requireTenantAuth succeeded. Staff sessions must present a valid approval token.
+ */
+export async function requireCeoApproval(
+  req: NextRequest,
+  session: UserSession
+): Promise<CeoGateResult> {
+  if (await hasValidCeoApproval(req, session)) return { ok: true };
+  return {
+    ok: false,
+    response: NextResponse.json(
+      {
+        success: false,
+        error: 'CEO approval required. Please enter the CEO password.',
+        code: 'CEO_APPROVAL_REQUIRED',
+      },
+      { status: 403 }
+    ),
+  };
+}
diff --git a/src/lib/ceoApprovalClient.ts b/src/lib/ceoApprovalClient.ts
new file mode 100644
index 0000000..ddabc03
--- /dev/null
+++ b/src/lib/ceoApprovalClient.ts
@@ -0,0 +1,79 @@
+/**
+ * Client-side storage + fetch helper for the CEO approval token (1 hour, per browser tab).
+ * The token only unlocks the protected actions for the staff user that earned it;
+ * the server re-validates it on every protected request.
+ */
+const STORAGE_KEY = 'pyntflow_ceo_approval_v1';
+export const CEO_APPROVAL_HEADER = 'x-ceo-approval';
+
+interface StoredApproval {
+  token: string;
+  expiresAt: number;
+  tenantId: string;
+}
+
+let memoryApproval: StoredApproval | null = null;
+
+function readStored(): StoredApproval | null {
+  if (memoryApproval) return memoryApproval;
+  try {
+    if (typeof window === 'undefined') return null;
+    const raw = window.sessionStorage.getItem(STORAGE_KEY);
+    if (!raw) return null;
+    const parsed = JSON.parse(raw) as StoredApproval;
+    if (parsed && parsed.token && parsed.expiresAt) {
+      memoryApproval = parsed;
+      return parsed;
+    }
+  } catch {
+    // storage unavailable — fall through
+  }
+  return null;
+}
+
+export function getCeoApproval(tenantId?: string | null): StoredApproval | null {
+  const a = readStored();
+  if (!a) return null;
+  // 30s safety margin so a token never expires mid-request
+  if (a.expiresAt - 30_000 <= Date.now()) {
+    clearCeoApproval();
+    return null;
+  }
+  if (tenantId && a.tenantId !== tenantId) return null;
+  return a;
+}
+
+export function setCeoApproval(tenantId: string, token: string, expiresAt: number): void {
+  memoryApproval = { token, expiresAt, tenantId };
+  try {
+    window.sessionStorage.setItem(STORAGE_KEY, JSON.stringify(memoryApproval));
+  } catch {
+    // ignore storage failures; memory copy still works for this page load
+  }
+}
+
+export function clearCeoApproval(): void {
+  memoryApproval = null;
+  try {
+    window.sessionStorage.removeItem(STORAGE_KEY);
+  } catch {
+    // ignore
+  }
+}
+
+/** fetch() that attaches the CEO approval header when one is held; clears it if the server rejects it. */
+export async function ceoFetch(input: string, init: RequestInit = {}, tenantId?: string | null): Promise<Response> {
+  const approval = getCeoApproval(tenantId);
+  const headers = new Headers(init.headers || {});
+  if (approval) headers.set(CEO_APPROVAL_HEADER, approval.token);
+  const res = await fetch(input, { ...init, headers });
+  if (res.status === 403) {
+    try {
+      const body = await res.clone().json();
+      if (body?.code === 'CEO_APPROVAL_REQUIRED') clearCeoApproval();
+    } catch {
+      // not JSON
+    }
+  }
+  return res;
+}
